<UserControl
    x:Class="Disker.App.Controls.PartitionBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border CornerRadius="6" Background="{ThemeResource CardStrokeColorDefaultBrush}" Padding="1" Height="36">
        <Grid x:Name="RootGrid" CornerRadius="5" ClipToBounds="True">
            <StackPanel x:Name="SegmentsContainer" Orientation="Horizontal" />
        </Grid>
    </Border>
</UserControl>
