<ui:FluentWindow
    x:Class="Disker.App.IsoWriteConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:Disker.App.Helpers"
    Title="Onay"
    Width="440" SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="#0B0F17"
    ExtendsContentIntoTitleBar="True"
    WindowCornerPreference="Round">

    <Grid Background="#0B0F17" Margin="20">
        <StackPanel>
            <!-- İkon + Başlık -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Background="#451A03" BorderBrush="#9A3412" BorderThickness="1" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                    <ui:SymbolIcon Symbol="Warning20" FontSize="18" Foreground="#F97316" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding L.ModalIsoWriteTitle}" FontSize="15" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="{Binding L.ModalIsoWriteSubtitle}" FontSize="10" Foreground="#64748B" />
                </StackPanel>
            </StackPanel>

            <!-- ISO + USB Bilgisi -->
            <Border Background="#0F1723" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="ISO:" FontSize="10" Foreground="#475569" Width="55" />
                        <TextBlock Text="{Binding SelectedIsoDisplayName}" FontSize="10" FontWeight="SemiBold" Foreground="#7DD3FC" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SelectedIsoSizeText, StringFormat=' ({0})'}" FontSize="10" Foreground="#64748B" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="USB:" FontSize="10" Foreground="#475569" Width="55" />
                        <TextBlock Text="{Binding SelectedUsbTarget.PrimaryVolumeTitle}" FontSize="10" FontWeight="SemiBold" Foreground="#F97316" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Uyarı -->
            <Border Background="#450A0A" BorderBrush="#991B1B" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="⚠  VERİ KAYBI UYARISI" FontWeight="Bold" FontSize="11" Foreground="#EF4444" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding L.ModalIsoWriteWarning}" FontSize="10" Foreground="#FCA5A5" TextWrapping="Wrap" LineHeight="16" />
                </StackPanel>
            </Border>

            <!-- Butonlar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,5,0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                        CornerRadius="7" Padding="0,9" Cursor="Hand" MouseLeftButtonUp="OnCancelClick">
                    <TextBlock Text="{Binding L.ModalIsoWriteCancel}" FontWeight="SemiBold" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" />
                </Border>

                <Border Grid.Column="1" Margin="5,0,0,0" Background="#C2410C" CornerRadius="7" Padding="0,9" Cursor="Hand" MouseLeftButtonUp="OnConfirmClick">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowDownload16" FontSize="12" Foreground="White" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding L.ModalIsoWriteConfirm}" FontWeight="Bold" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
