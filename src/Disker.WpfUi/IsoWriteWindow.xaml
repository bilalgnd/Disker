<ui:FluentWindow
    x:Class="Disker.App.IsoWriteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:Disker.App.Helpers"
    xmlns:models="clr-namespace:Disker.Core.Models;assembly=Disker.Core"
    Title="Create Bootable USB"
    Icon="Assets/app.ico"
    Width="520" SizeToContent="Height"
    MinWidth="480" MaxWidth="560" MaxHeight="900"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    WindowBackdropType="Acrylic"
    Background="Transparent"
    ExtendsContentIntoTitleBar="True"
    WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <helpers:PercentToWidthConverter x:Key="PercentToWidthConverter" />

        <!-- 2026 Minimal Dark Theme Palette -->
        <SolidColorBrush x:Key="CardBgBrush" Color="#151D2A" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#232E42" />
        <SolidColorBrush x:Key="InputBgBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#334155" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />

        <!-- 100% Güvenilir ve Net Koyu Tema ComboBox Şablonu -->
        <ControlTemplate x:Key="DarkComboBoxToggleBtn" TargetType="ToggleButton">
            <Border x:Name="BtnBdr" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="1" Symbol="ChevronDown16" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBdr" Property="BorderBrush" Value="#38BDF8" />
                    <Setter TargetName="BtnBdr" Property="Background" Value="#24334A" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <ToggleButton Name="ToggleButton"
                                          Template="{StaticResource DarkComboBoxToggleBtn}"
                                          Focusable="False"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,32,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Name="DropDownBorder"
                                        Background="#151D2A"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="200"
                                        Padding="4"
                                        Margin="0,4,0,0">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBdr" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBdr" Property="Background" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBdr" Property="Background" Value="#1E3A5F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="#B3080C14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Title Bar -->
            <RowDefinition Height="*" />    <!-- Content Area -->
            <RowDefinition Height="Auto" /> <!-- Footer Area -->
        </Grid.RowDefinitions>

        <!-- 1. Başlık Çubuğu -->
        <Border Grid.Row="0" Background="#0E131E" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1A3321" BorderBrush="#166534" BorderThickness="1" CornerRadius="8" Width="32" Height="32" Margin="0,0,12,0">
                        <ui:SymbolIcon Symbol="UsbStick20" FontSize="16" Foreground="#4ADE80" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Create Bootable USB" FontSize="14" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Win32 Native DD Engine • 32MB Sektör Hizalamalı" FontSize="11" Foreground="#64748B" />
                    </StackPanel>
                </StackPanel>

                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" CornerRadius="14"
                        Background="#1E293B" Cursor="Hand" MouseLeftButtonUp="OnCloseWindowClick">
                    <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- 2. Ana Rufus Kontrol Paneli -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,14,18,14">

                <!-- ════════ BÖLÜM 1: SÜRÜCÜ ÖZELLİKLERİ ════════ -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Sürücü Özellikleri" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Separator Grid.Column="1" Background="#1E293B" VerticalAlignment="Center" />
                </Grid>

                <!-- Aygıt (Device) -->
                <TextBlock Text="Aygıt" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                          ItemsSource="{Binding UsbDrives}"
                          SelectedItem="{Binding SelectedUsbTarget, Mode=TwoWay}"
                          Margin="0,0,0,10">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:PhysicalDiskInfo}">
                            <TextBlock Text="{Binding PrimaryVolumeTitle, StringFormat='{}{0}'}" FontWeight="SemiBold" FontSize="12" Foreground="White" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Önyükleme Seçimi (Boot selection) -->
                <TextBlock Text="Önyükleme seçimi" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Boot Selection Dropdown (Rufus stili: Non bootable / ISO Name / FreeDOS / MS-DOS) -->
                    <ComboBox Grid.Column="0"
                              Style="{StaticResource DarkComboBoxStyle}"
                              ItemsSource="{Binding BootSelectionOptions}"
                              SelectedItem="{Binding SelectedBootOption, Mode=TwoWay}" />

                    <!-- SHA-256 Hash Butonu -->
                    <Border Grid.Column="1" Width="36" Height="36" Margin="6,0,0,0"
                            Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6"
                            Cursor="Hand" ToolTip="ISO SHA-256 Sağlama Toplamını Hesapla"
                            MouseLeftButtonUp="OnCalculateChecksumClick">
                        <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="16" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- SEÇ Butonu -->
                    <Border Grid.Column="2" Margin="6,0,0,0"
                            Background="#2563EB" CornerRadius="6" Padding="18,0" Height="36"
                            Cursor="Hand" MouseLeftButtonUp="OnSelectIsoClick">
                        <TextBlock Text="SEÇ" FontWeight="Bold" FontSize="12" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Yansı Seçeneği (Image option: Standard Windows installation / Windows To Go) -->
                <StackPanel Visibility="{Binding IsImageOptionVisible, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,10">
                    <TextBlock Text="Yansı seçeneği" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                    <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                              ItemsSource="{Binding ImageOptionList}"
                              SelectedItem="{Binding SelectedImageOption, Mode=TwoWay}" />
                </StackPanel>

                <!-- ISO Detay Rozeti & Hash -->
                <Border Visibility="{Binding HasSelectedIso, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="#0D1B2A" BorderBrush="#1E4D6B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#1E3A5F" CornerRadius="3" Padding="5,1" Margin="0,0,8,0">
                                <TextBlock Text="{Binding SelectedIsoType}" FontSize="10" FontWeight="Bold" Foreground="#60A5FA" />
                            </Border>
                            <TextBlock Text="{Binding SelectedIsoSizeText}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding IsoChecksumInfo}" FontSize="10" Foreground="#34D399" Margin="0,3,0,0"
                                   Visibility="{Binding IsoChecksumInfo, Converter={StaticResource BoolToVisibilityConverter}}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Bölüm Düzeni & Hedef Sistem -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Bölüm düzeni" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                        <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                  ItemsSource="{Binding IsoPartitionSchemes}"
                                  SelectedItem="{Binding IsoPartitionScheme, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Hedef sistem" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                        <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                  ItemsSource="{Binding IsoTargetSystems}"
                                  SelectedItem="{Binding IsoTargetSystem, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>

                <!-- Gelişmiş Sürücü Özellikleri Aç/Kapa -->
                <Border Background="Transparent" Cursor="Hand" Margin="0,0,0,10" MouseLeftButtonUp="OnToggleAdvancedDriveClick">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ChevronDown16" FontSize="11" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Gelişmiş sürücü özelliklerini göster" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Visibility="{Binding ShowAdvancedDriveProperties, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="#0D1117" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox Content="Eski BIOS'lar için düzeltme ekle (bölümleme hizalaması vb.)" IsChecked="True" />
                        <CheckBox Content="Rufus MBR BIOS Kimliğini kullan" IsChecked="True" />
                    </StackPanel>
                </Border>


                <!-- ════════ BÖLÜM 2: BİÇİMLENDİRME SEÇENEKLERİ ════════ -->
                <Grid Margin="0,4,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Biçimlendirme Seçenekleri" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Separator Grid.Column="1" Background="#1E293B" VerticalAlignment="Center" />
                </Grid>

                <!-- Birim Etiketi (Volume label) -->
                <TextBlock Text="Birim etiketi" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Height="36" Padding="10,0" Margin="0,0,0,10">
                    <TextBox Text="{Binding IsoVolumeLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0" Foreground="White" FontSize="12" FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                </Border>

                <!-- Dosya Sistemi & Ayırma Birimi Boyutu -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Dosya sistemi" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                        <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                  ItemsSource="{Binding IsoFileSystems}"
                                  SelectedItem="{Binding IsoFileSystem, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ayırma birimi boyutu" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                        <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                  ItemsSource="{Binding IsoClusterSizes}"
                                  SelectedItem="{Binding IsoClusterSize, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>

                <!-- Gelişmiş Biçimlendirme Seçenekleri Aç/Kapa -->
                <Border Background="Transparent" Cursor="Hand" Margin="0,0,0,10" MouseLeftButtonUp="OnToggleAdvancedFormatClick">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ChevronDown16" FontSize="11" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Gelişmiş biçimlendirme seçeneklerini göster" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Visibility="{Binding ShowAdvancedFormatOptions, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="#0D1117" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox Content="Hızlı biçimlendir" IsChecked="{Binding IsoQuickFormat, Mode=TwoWay}" />
                        <CheckBox Content="Genişletilmiş etiket ve simge dosyaları oluştur" IsChecked="{Binding IsoCreateExtendedLabel, Mode=TwoWay}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Content="Hatalı bloklar için aygıtı denetle" IsChecked="{Binding IsoCheckBadBlocks, Mode=TwoWay}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBoxStyle}" Height="28"
                                      ItemsSource="{Binding IsoBadBlockPassList}" SelectedItem="{Binding IsoBadBlocksPasses, Mode=TwoWay}"
                                      IsEnabled="{Binding IsoCheckBadBlocks}" />
                        </Grid>
                    </StackPanel>
                </Border>


                <!-- ════════ BÖLÜM 3: DURUM (STATUS) ════════ -->
                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Durum" FontSize="12" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Separator Grid.Column="1" Background="#1E293B" VerticalAlignment="Center" />
                </Grid>

                <!-- Canlı İlerleme / Durum Çubuğu -->
                <Border x:Name="StatusBarContainer" Background="#151D2A" BorderBrush="#232E42" BorderThickness="1" CornerRadius="6" Height="40" Margin="0,0,0,10">
                    <Grid>
                        <!-- İlerleme Dolgusu -->
                        <Border Background="#16A34A" CornerRadius="5" HorizontalAlignment="Left"
                                Visibility="{Binding IsIsoWriting, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                    <Binding Path="IsoWriteProgressPercent" />
                                    <Binding Path="ActualWidth" ElementName="StatusBarContainer" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>

                        <!-- Durum Metni -->
                        <TextBlock Text="{Binding IsoWriteStatusText}" FontWeight="Bold" FontSize="12" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Hata & Başarı Bildirimleri -->
                <Border Visibility="{Binding IsoWriteErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="#450A0A" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                    <TextBlock Text="{Binding IsoWriteErrorMessage}" FontSize="11" FontWeight="Bold" Foreground="#FCA5A5" TextWrapping="Wrap" />
                </Border>
                <Border Visibility="{Binding IsoWriteSuccessMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                    <TextBlock Text="{Binding IsoWriteSuccessMessage}" FontSize="11" FontWeight="Bold" Foreground="#86EFAC" TextWrapping="Wrap" />
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 3. Alt Buton Paneli -->
        <Border Grid.Row="2" Background="#0E131E" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Sol İkonlar (Log, Bilgi, Aygıt Sayacı) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="4" Background="#1E293B" Margin="0,0,6,0" Cursor="Hand" ToolTip="Log Görüntüleyici" MouseLeftButtonUp="OnViewLogClick">
                        <ui:SymbolIcon Symbol="DocumentText20" FontSize="13" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Width="30" Height="30" CornerRadius="4" Background="#1E293B" Margin="0,0,8,0" Cursor="Hand" ToolTip="Hakkında" MouseLeftButtonUp="OnAboutClick">
                        <ui:SymbolIcon Symbol="Info20" FontSize="13" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding IsoWriteDeviceCountText}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>

                <!-- Sağ İşlem Butonları -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- BAŞLAT Butonu -->
                    <Border Background="#16A34A" CornerRadius="4" Padding="24,9" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="OnStartWriteClick"
                            Visibility="{Binding IsIsoWriting, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedIso}" Value="False">
                                        <Setter Property="Opacity" Value="0.35" />
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasUsbDrives}" Value="False">
                                        <Setter Property="Opacity" Value="0.35" />
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="BAŞLAT" FontWeight="Bold" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                    </Border>

                    <!-- İPTAL ET Butonu (Yazarken) -->
                    <Border Background="#DC2626" CornerRadius="4" Padding="20,9" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="OnCancelWriteClick"
                            Visibility="{Binding IsIsoWriting, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="İPTAL ET" FontWeight="Bold" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                    </Border>

                    <!-- KAPAT Butonu -->
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="22,9" Cursor="Hand" MouseLeftButtonUp="OnCloseWindowClick">
                        <TextBlock Text="KAPAT" FontWeight="SemiBold" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
